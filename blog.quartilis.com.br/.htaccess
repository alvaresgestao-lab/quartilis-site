RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RedirectMatch 301 ^/(inspiracoes|dicas|pagina-inicial|blog)/?$ /
RedirectMatch 301 ^/category/.*$ /
RedirectMatch 301 ^/(feed|comments/feed)/?$ /
RedirectMatch 301 ^/2026/09/21/casamento-de-fim-de-ano-em-curitiba-o-que-muda-na-musica-ao-vivo/?$ /
