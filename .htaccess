# Quartilis — site estático
RewriteEngine On

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Força versão sem www (evita home duplicada no Google)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /index.html -> / (evita duplicata)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirects 301 das URLs antigas do Drupal (preserva SEO)
RedirectMatch 301 ^/quartilis/repertorio$ /repertorio/
RedirectMatch 301 ^/quartilis/musicos$ /musicos/
RedirectMatch 301 ^/quartilis/servi.*$ /servicos/
RedirectMatch 301 ^/quartilis/fotos-e-videos.*$ /fotos-e-videos/
RedirectMatch 301 ^/quartilis/contato$ /contato/
RedirectMatch 301 ^/quartilis/?$ /
RedirectMatch 301 ^/quartilis/.+$ /

# Cache de estáticos
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
